# Optional app-wide Basic Auth for pages and browser APIs.
# Recommended for every deployed instance because portfolio data is private.
APP_ACCESS_USER=
APP_ACCESS_PASSWORD=

# Market data provider: auto | demo | twelve-data
MARKET_DATA_PROVIDER=auto

# When present, auto mode uses Twelve Data. Keep real keys outside Git.
TWELVE_DATA_API_KEY=

# Fundamental provider (Company Overview / ratios / growth metrics)
ALPHA_VANTAGE_API_KEY=

# Direct official IOL API. Preferred over the generic bridge when configured.
# Production default: https://api.invertironline.com
# Use IOL's sandbox base URL while developing/testing orders.
IOL_API_BASE_URL=https://api.invertironline.com
IOL_API_USERNAME=
IOL_API_PASSWORD=

# Execution safety policy: disabled | sandbox | production
# Production placement remains blocked unless IOL_PRODUCTION_TRADING_ENABLED=true.
IOL_EXECUTION_MODE=disabled
IOL_PRODUCTION_TRADING_ENABLED=false

# Generic IOL bridge fallback. Never commit broker credentials.
IOL_BRIDGE_URL=
IOL_BRIDGE_TOKEN=
IOL_QUOTE_BRIDGE_URL=
IOL_ORDER_BRIDGE_URL=

# Optional metadata bridge for explicit related symbols (ARS / D / cable).
# The app NEVER invents the cable ticker by suffix; it only uses metadata returned here.
IOL_ASSET_METADATA_BRIDGE_URL=
IOL_ASSET_METADATA_BRIDGE_TOKEN=

# Option A: one bridge returns ratio + CCL + local price in a single payload.
CEDEAR_CONVERSION_BRIDGE_URL=
CEDEAR_CONVERSION_BRIDGE_TOKEN=

# Option B: composite providers. Used when the all-in-one bridge above is absent.
# Ratio bridge should normalize an official/primary source such as Caja de Valores or the program issuer.
CEDEAR_RATIO_BRIDGE_URL=
CEDEAR_RATIO_BRIDGE_TOKEN=

# Global CCL benchmark/fallback. When implied cable CCL exists, the benchmark is
# still used to detect abnormal instrument-specific divergence before confirmation.
CCL_BRIDGE_URL=
CCL_BRIDGE_TOKEN=

# Monitoring endpoint protection
MONITOR_CRON_TOKEN=

# Autonomous scanner configuration
# Format: SYMBOL:strategy,SYMBOL:strategy where strategy is day | swing | position
MONITOR_WATCHLIST=NVDA:position,GOOGL:position
MONITOR_PORTFOLIO_STRATEGY=position
MONITOR_MAX_SYMBOLS=50

# Persistent alert deduplication (optional but recommended)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ALERT_DEDUP_TTL_SECONDS=86400

# Notification providers
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT=
WHATSAPP_GRAPH_VERSION=
