# Optional app-wide Basic Auth for pages and browser APIs.
# Recommended for every deployed instance because portfolio data is private.
APP_ACCESS_USER=
APP_ACCESS_PASSWORD=

# Market data provider: auto | demo | twelve-data
MARKET_DATA_PROVIDER=auto
TWELVE_DATA_API_KEY=
TWELVE_DATA_PORTFOLIO_BATCH_SIZE=5
TWELVE_DATA_CACHE_TTL_SECONDS=90

# Fundamental / insights provider
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_CACHE_TTL_HOURS=12
ALPHA_VANTAGE_NEWS_CACHE_TTL_HOURS=6
ALPHA_VANTAGE_EVENTS_CACHE_TTL_HOURS=24

# Direct official IOL API. Preferred over the generic bridge when configured.
IOL_API_BASE_URL=https://api.invertironline.com
IOL_API_USERNAME=
IOL_API_PASSWORD=

# Execution safety policy: disabled | sandbox | production
# sandbox = broker validation + local simulation only; never places a live order.
# production = validation/review only. Live placement from the web-app is disabled by design.
IOL_EXECUTION_MODE=disabled
ORDER_CONFIRMATION_SECRET=

# Optional append-only audit bridge. If absent, audit events are written to server logs.
ORDER_AUDIT_BRIDGE_URL=
ORDER_AUDIT_BRIDGE_TOKEN=

# Generic IOL bridge fallback. Never commit broker credentials.
IOL_BRIDGE_URL=
IOL_BRIDGE_TOKEN=
IOL_QUOTE_BRIDGE_URL=
IOL_ORDER_BRIDGE_URL=

# Optional metadata bridge for explicit related symbols (ARS / D / cable).
IOL_ASSET_METADATA_BRIDGE_URL=
IOL_ASSET_METADATA_BRIDGE_TOKEN=

# CEDEAR conversion sources
CEDEAR_CONVERSION_BRIDGE_URL=
CEDEAR_CONVERSION_BRIDGE_TOKEN=
CEDEAR_RATIO_PROVIDER=auto
CEDEAR_CAJA_URL=https://cajadevalores.com.ar/Servicios/Cedears
CEDEAR_RATIO_BRIDGE_URL=
CEDEAR_RATIO_BRIDGE_TOKEN=

# Global CCL benchmark/fallback
CCL_BRIDGE_URL=
CCL_BRIDGE_TOKEN=

# Monitoring endpoint protection
MONITOR_CRON_TOKEN=
MONITOR_WATCHLIST=NVDA:position,GOOGL:position
MONITOR_PORTFOLIO_STRATEGY=position
MONITOR_MAX_SYMBOLS=50

# Quota-aware market discovery. Rotates a small batch outside portfolio/watchlist,
# applies a cheap technical prefilter, then promotes only stronger candidates.
MARKET_SCANNER_ENABLED=true
MARKET_SCANNER_BATCH_SIZE=2
MARKET_SCANNER_MIN_SCORE=66
# Maximum number of scanner discoveries that receive the expensive full analysis per cycle.
MARKET_SCANNER_PROMOTION_LIMIT=1
# Require repeated confirmation before expensive analysis. A very strong score can bypass this gate.
MARKET_SCANNER_MIN_CONFIRMATIONS=2
MARKET_SCANNER_FAST_TRACK_SCORE=85
# Optional comma-separated universe. If empty, a curated liquid US universe is used.
MARKET_SCANNER_UNIVERSE=

# Redis REST: alert deduplication + bounded activity history
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ALERT_DEDUP_TTL_SECONDS=86400
ACTIVITY_HISTORY_MAX_ITEMS=1000

# Notification providers
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT=
WHATSAPP_GRAPH_VERSION=
